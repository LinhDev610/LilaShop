# -----------------------------------------------------------------------------
# LilaShop Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# -----------------------------------------------------------------------------

# Database Configuration
DBMS_CONNECTION=jdbc:mysql://mysql:3306/lila_shop
DBMS_USERNAME=root
DBMS_PASSWORD=root

# Security Key for JWT
JWT_SIGNERKEY=your_jwt_signer_key_here

# Brevo (Sendinblue) Email configuration
BREVO_API_KEY=your_brevo_api_key_here
BREVO_EMAIL=your_brevo_email_here

# GHN (Giao Hàng Nhanh) Shipping Service configuration
GHN_TOKEN=your_ghn_token_here
GHN_SHOP_ID=your_ghn_shop_id_here

# Cloudinary configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Docker Hub Configuration
DOCKER_USERNAME=your_docker_username_here

# DuckDNS Configuration
DUCKDNS_SUBDOMAINS=your_duckdns_subdomain_here
DUCKDNS_TOKEN=your_duckdns_token_here